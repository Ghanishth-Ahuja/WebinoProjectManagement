// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  admin
  member
}

enum Priority {
  low
  medium
  high
  urgent
}

//models

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  role          Roles         @default(member)
  assignedTasks Tasks[]       @relation("TaskAssignee")
  avatar        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt()
  comments      Comment[]     @relation("Comments")
  attachments   Attachments[]
  ownedProjects Projects[]    @relation("ProjectOwner") //array means, one user can create many projects

  sentNotifications     Notification[]   @relation("NotificationSender")
  receivedNotifications Notification[]   @relation("NotificationReceiver")
  memberof              ProjectMembers[]
  invitations           ProjectInvitation[] 
}

model Tasks {
  id            String         @id @default(uuid())
  position      Int            @default(0)
  title         String
  description   String?
  deadline      DateTime?
  priority      Priority
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignee      User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId    String?
  comment       Comment[]
  attachments   Attachments[]
  isComplete    Boolean        @default(false)
  list          List           @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId        String
  project       Projects       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  notifications Notification[]

  @@index([listId]) //  Fast: "Get all tasks in this list"
  @@index([projectId]) //  Fast: "Get all tasks in this project"
  @@index([assigneeId]) //  Fast: "Get all tasks assigned to this user"
  @@index([deadline]) //  Fast: "Get all overdue tasks"
  @@index([position]) //  Fast: Ordering tasks for display
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Tasks  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  author   User   @relation("Comments", fields: [authorId], references: [id])
  authorId String

  @@index([taskId]) // Fast: "Get all comments on this task"
  @@index([authorId])
}

model Attachments {
  id         String   @id @default(uuid())
  url        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Tasks    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  uploadedBy User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String

  @@index([taskId]) // Fast: "Get all files on this task"
  @@index([uploaderId])
}

model Projects {
  id             String           @id @default(uuid())
  title          String
  createdBy      User             @relation("ProjectOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lists          List[]
  projectmembers ProjectMembers[]
  tasks          Tasks[]
  notifications  Notification[]
  invitations    ProjectInvitation[]
}

model List {
  id        String   @id @default(uuid())
  title     String
  position  Int
  color     String?
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  tasks     Tasks[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId]) // Fast: "Get all lists in this project"
  @@index([position])
}

model ProjectMembers {
  id        String   @id @default(uuid())
  role      String   @default("member")
  projectId String
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // One user can't be added twice to same project
  @@index([projectId]) //Fast: "Get all members of this project"
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String //like a task is assigned or a comment is added
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  task      Tasks    @relation(fields: [taskId], references: [id])
  taskId    String
  project   Projects @relation(fields: [projectId], references: [id])
  projectId String

  // SENDER = User who performed the action
  senderId String
  sender   User   @relation("NotificationSender", fields: [senderId], references: [id])

  // RECEIVER = User who receives the notification
  receiverId String
  receiver   User   @relation("NotificationReceiver", fields: [receiverId], references: [id])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime
  isUsed Boolean @default(false)
  @@unique([email, token])
}
model ProjectInvitation {
  id         String   @id @default(uuid())
  email      String
  role       Roles     @default(member)
  token      String   @unique  // For accept link
  status     String   @default("PENDING")  // PENDING, ACCEPTED, DECLINED
  expiresAt  DateTime
  
  projectId  String
  project    Projects @relation(fields: [projectId], references: [id])
  
  invitedBy  String
  inviter    User     @relation(fields: [invitedBy], references: [id])
}